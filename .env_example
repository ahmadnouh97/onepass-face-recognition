# Docker Compose reads this value for the PostgreSQL container.
# Use a long unique password and repeat it (URL-encoded when needed) in
# GATEWATCH_DATABASE_URL below.
POSTGRES_PASSWORD=change-this-before-production

# Required before a shared PostgreSQL deployment.
GATEWATCH_DATABASE_URL=postgresql+psycopg://gatewatch:change-this-before-production@127.0.0.1:5432/gatewatch
GATEWATCH_JWT_SECRET=replace-with-a-long-random-secret
GATEWATCH_DEMO_ADMIN_USERNAME=admin
GATEWATCH_DEMO_ADMIN_PASSWORD=change-me-now
# Maximum cosine distance for a match or enrollment duplicate: lower is
# stricter, higher is looser. Restart the API after changing this value.
GATEWATCH_RECOGNITION_THRESHOLD=0.32

# The current Compose Redis service has no password and is not used by the
# current live pipeline. Do not expose port 6379 to untrusted networks.
GATEWATCH_REDIS_URL=redis://127.0.0.1:6379/0
